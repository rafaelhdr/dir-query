# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/

# Env
.env

# Uploaded files (local dev storage)
backend/data/uploads/*
!backend/data/uploads/.gitkeep

# RAG index (regenerable from uploads)
backend/data/index/*
!backend/data/index/.gitkeep

# Embedding model download cache
backend/data/hf-cache/*
!backend/data/hf-cache/.gitkeep

# Local secrets
secrets/*
!secrets/.gitkeep
!secrets/*.example

# Editors
.vscode/
.idea/
*.swp

# OS
.DS_Store
