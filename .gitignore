# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/

# Env
.env

# Uploaded files (local dev storage)
backend/data/uploads/*
!backend/data/uploads/.gitkeep

# Embedding model download cache
backend/data/hf-cache/*
!backend/data/hf-cache/.gitkeep

# Postgres data directory (bind-mounted so `wt step copy-ignored` can
# replicate it into new worktrees)
pg_data/*
!pg_data/.gitkeep

# Local secrets
secrets/*
!secrets/.gitkeep
!secrets/*.example

# Editors
.vscode/
.idea/
*.swp

# OS
.DS_Store

# Claude Code personal settings
.claude/settings.local.json

# Worktrunk worktrees
.worktrees/
