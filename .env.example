BACKEND_PORT=8000
FRONTEND_PORT=8080
COMPOSE_PROJECT_NAME=dir_query

# Production only — ignored by local development (docker-compose.yml alone
# never reads it). Required when running with docker-compose.prod.yml: the
# public domain Caddy requests an HTTPS certificate for and terminates TLS
# on. See AGENTS.md's "Production deployment" section.
# DOMAIN=example.com

# Production only — ignored by local development. Required when running
# with docker-compose.prod.yml if the domain is proxied through Cloudflare
# (orange cloud): a Cloudflare API token scoped to Zone:DNS:Edit for the
# domain's zone, letting Caddy prove domain ownership via a DNS-01
# challenge instead of the HTTP-01 challenge Cloudflare's proxy blocks.
# Create it at https://dash.cloudflare.com/profile/api-tokens using the
# "Edit zone DNS" template, scoped to the specific zone. See AGENTS.md's
# "Production deployment" section.
# CLOUDFLARE_API_TOKEN=

# Embedding provider used for indexing/retrieval: "cpu" (local model, no API
# key needed) or "gemini" (needs GOOGLE_API_KEY). See AGENTS.md — switching
# this on a deployment with existing indexed data requires running
# scripts/reset_embeddings.py.
# EMBED_PROVIDER=cpu

# LLM provider used to answer questions: "minimax" or "gemini" (needs
# GOOGLE_API_KEY).
# LLM_PROVIDER=minimax

# MiniMax API key, needed only if LLM_PROVIDER=minimax (the default).
# Recommended: put your key in secrets/minimax_api_key.txt instead (copy from
# secrets/minimax_api_key.txt.example) — see AGENTS.md. This env var is a
# fallback for when a secrets file isn't convenient.
# MINIMAX_API_KEY=

# Override the MiniMax chat model used to answer questions.
# MINIMAX_LLM_MODEL=MiniMax-M2.7

# Google API key, needed only if EMBED_PROVIDER=gemini and/or
# LLM_PROVIDER=gemini. Recommended: put your key in
# secrets/google_api_key.txt instead (copy from
# secrets/google_api_key.txt.example) — see AGENTS.md. This env var is a
# fallback for when a secrets file isn't convenient.
# GOOGLE_API_KEY=

# Override the Gemini models used for completions/embeddings.
# GEMINI_LLM_MODEL=gemini-3-flash-preview
# GEMINI_EMBED_MODEL=gemini-embedding-001

# Postgres connection. Change POSTGRES_PASSWORD before any real use — this
# placeholder is only safe for local development.
POSTGRES_USER=dir_query
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=dir_query
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
