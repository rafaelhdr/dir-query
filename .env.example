BACKEND_PORT=8000
FRONTEND_PORT=8080

# MiniMax API key, needed only for /ask (not for uploading/indexing documents).
# Recommended: put your key in secrets/minimax_api_key.txt instead (copy from
# secrets/minimax_api_key.txt.example) — see AGENTS.md. This env var is a
# fallback for when a secrets file isn't convenient.
# MINIMAX_API_KEY=

# Override the MiniMax chat model used to answer questions.
# MINIMAX_LLM_MODEL=MiniMax-M2.7

# Postgres connection. Change POSTGRES_PASSWORD before any real use — this
# placeholder is only safe for local development.
POSTGRES_USER=understand_your_stuffs
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=understand_your_stuffs
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
